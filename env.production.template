# ============================================
# Variables d'environnement - Production
# ============================================

# Environnement
NODE_ENV=production

# Serveur
PORT=3000

# Frontend URL pour CORS (à remplacer par votre domaine)
FRONTEND_URL=https://votre-domaine.com

# Clés secrètes (à générer avec: openssl rand -hex 32)
# JWT_SECRET=votre-cle-secrete-jwt-super-longue-et-aleatoire
API_KEY=OBLIGATOIRE - sans elle, POST /api/v1/alerts renvoie 503 (fail-closed)

# Base de données (si PostgreSQL activé)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=sentinel_x
# DB_USER=sentinel
# DB_PASSWORD=votre-mot-de-passe-securise

# Redis (si activé pour scaling WebSocket)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=info

# Reverse proxy : 1 saut de confiance (le reverse proxy est le seul accès à l'API)
TRUST_PROXY=1

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
# Assez large pour un dashboard qui interroge l'API en secours du WebSocket
RATE_LIMIT_MAX_REQUESTS=600
# Ingestion des alertes : fenêtre glissante de 1 minute
RATE_LIMIT_INGEST_MAX_REQUESTS=60