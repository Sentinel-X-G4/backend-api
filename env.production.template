# ============================================
# Variables d'environnement - Production
# ============================================

# Environnement
NODE_ENV=production

# Serveur
PORT=3000

# Frontend URL pour CORS (à remplacer par votre domaine)
FRONTEND_URL=https://votre-domaine.com

# Clés secrètes (à générer avec: openssl rand -hex 32)
# JWT_SECRET=votre-cle-secrete-jwt-super-longue-et-aleatoire
# API_KEY=votre-cle-api-pour-authentification

# Base de données (si PostgreSQL activé)
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=sentinel_x
# DB_USER=sentinel
# DB_PASSWORD=votre-mot-de-passe-securise

# Redis (si activé pour scaling WebSocket)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100