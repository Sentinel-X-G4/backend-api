# ============================================
# .dockerignore pour Sentinel-X Backend API
# ============================================

# Dépendances (réinstallées dans le container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fichiers d'environnement locaux
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log

# IDE et éditeurs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation
README.md
CHANGELOG.md
LICENSE

# Tests et coverage
coverage/
.nyc_output/
*.test.js
*.spec.js

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml

# Fichiers temporaires
tmp/
temp/
*.tmp
*.temp

# Base de données locale (si SQLite)
*.db
*.sqlite
*.sqlite3

# Build artifacts
dist/
build/