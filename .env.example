# ============================================
# Sentinel-X Backend API - Variables d'environnement
# ============================================

# === Côté serveur ===
NODE_ENV=development
PORT=3000

# === CORS / Frontend ===
# Origine(s) autorisée(s) pour les requêtes CORS (coma-separated).
# Défaut : "*" (ouvrir à toutes les origines) — c'est pour le cas
# "backend seul, pas encore de frontend connecté".
# En prod réelle derrière ton reverse proxy, mets l'URL exacte du dashboard.
FRONTEND_URL=http://localhost:5173

# === Auth ingestion (Backend IoT / MQTT) ===
# Clé d'authentification pour POST /api/v1/alerts (header X-API-Key).
# - En dev : mettre une valeur pour tester ; la clé est envoyée en clair
#   dans l'environnement, ce n'est pas un secret de production.
# - En prod : OBLIGATOIRE. Sans elle, POST /api/v1/alerts renvoie 503
#   (fail-closed). Génère une clé propre avec: openssl rand -hex 32
API_KEY=dev-api-key-change-in-production

# === Sécurité (activé plus tard) ===
# JWT_SECRET : pour l'authentification du dashboard (contrôle distance actionneurs)
# à activer quand l'auth utilisateur sera nécessaire.
# JWT_SECRET=votre-cle-secrete-jwt-super-longue-et-aleatoire

# === Reverse proxy ===
# TRUST_PROXY : à 1 quand l'API est derrière un reverse proxy (Baptiste/Charles).
# Permet de récupérer la vraie IP cliente pour le rate limiting et les logs.
# À mettre à false si l'API est exposée directement sans reverse proxy.
TRUST_PROXY=1

# === Logging ===
LOG_LEVEL=debug
# LOG_LEVEL=info en production

# === Rate limiting ===
# Fenêtre du rate limit global (en millisecondes, 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Requêtes max par fenêtre globale (health check exempt)
RATE_LIMIT_MAX_REQUESTS=1000
# POST /api/v1/alerts max par minute (fenêtre glissante 1 min)
RATE_LIMIT_INGEST_MAX_REQUESTS=60

# === Base de données PostgreSQL (à activer plus tard) ===
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sentinel_x_dev
# DB_USER=sentinel
# DB_PASSWORD=votre-mot-de-passe-securise

# === Redis (scale WebSocket, à activer plus tard) ===
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
