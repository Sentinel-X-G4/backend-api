# ============================================
# Variables d'environnement - Développement
# ============================================

# Environnement
NODE_ENV=development

# Serveur
PORT=3000

# Frontend URL pour CORS (Vite par défaut)
FRONTEND_URL=http://localhost:5173

# Clés secrètes (valeurs de développement uniquement)
JWT_SECRET=dev-secret-key-change-in-production
API_KEY est OBLIGATOIRE pour l'ingestion POST /api/v1/alerts (envoyée en X-API-Key)

# Base de données (si PostgreSQL activé)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sentinel_x_dev
# DB_USER=sentinel
# DB_PASSWORD=devpassword

# Redis (si activé)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Logging
LOG_LEVEL=debug

# Reverse proxy : nombre de sauts à faire confiance pour la vraie IP cliente
# (indispensable au rate limiting derrière le reverse proxy)
TRUST_PROXY=1

# Rate limiting (désactivé en dev)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
# Ingestion des alertes : fenêtre glissante de 1 minute
RATE_LIMIT_INGEST_MAX_REQUESTS=60