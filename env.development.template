# ============================================
# Variables d'environnement - Développement
# ============================================

# Environnement
NODE_ENV=development

# Serveur
PORT=3000

# Frontend URL pour CORS (Vite par défaut)
FRONTEND_URL=http://localhost:5173

# Clés secrètes (valeurs de développement uniquement)
JWT_SECRET=dev-secret-key-change-in-production
API_KEY=dev-api-key-change-in-production

# Base de données (si PostgreSQL activé)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sentinel_x_dev
# DB_USER=sentinel
# DB_PASSWORD=devpassword

# Redis (si activé)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Logging
LOG_LEVEL=debug

# Rate limiting (désactivé en dev)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000